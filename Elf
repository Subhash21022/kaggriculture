{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.18","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":177055}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Elf Calculator in 191,867 instructions\n\nA CPU beam search builds all 1,000 arithmetic programs. Run the notebook to generate `submission.csv` and replay every instruction to verify the score.","metadata":{}},{"cell_type":"markdown","source":"## Load the puzzles\n\nEach puzzle starts with a few positive integers in a bank of 48 registers. A target counts as soon as it appears, so its register can later be reused. [Competition data and calculator rules](https://www.kaggle.com/competitions/santa-2026/data)","metadata":{}},{"cell_type":"code","source":"import csv\nimport json\nimport os\nimport subprocess\nimport tempfile\nfrom concurrent.futures import ThreadPoolExecutor\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nif Path(\"/kaggle/input\").is_dir():\n    candidates = sorted(Path(\"/kaggle/input\").rglob(\"puzzles.csv\"))\n    output = Path(\"/kaggle/working/submission.csv\")\nelse:\n    candidates = [parent / \"data/puzzles.csv\" for parent in (Path.cwd(), *Path.cwd().parents)]\n    output = Path.cwd() / \"submission.csv\"\n\npuzzle_file = next((p for p in candidates if p.is_file()), None)\nif puzzle_file is None:\n    raise FileNotFoundError(\"Attach the Santa 2026 competition data or place puzzles.csv in data/.\")\nscratch = tempfile.TemporaryDirectory()\nsolver_source = Path(scratch.name) / \"solver.cpp\"\nsolver_binary = Path(scratch.name) / \"solver\"\n\n@dataclass(frozen=True)\nclass Puzzle:\n    starts: tuple\n    targets: frozenset\n    limit: int\n    registers: int\n\n\ndef load_puzzles(path):\n    with open(path, encoding=\"utf-8\", newline=\"\") as f:\n        return {r[\"id\"]: Puzzle(tuple(json.loads(r[\"starting_values\"])),\n                                frozenset(json.loads(r[\"targets\"])),\n                                int(r[\"value_limit\"]), int(r[\"registers\"]))\n                for r in csv.DictReader(f)}\n\n\n\npuzzles = load_puzzles(puzzle_file)\nassert set(puzzles) == {f\"scored_{i:04d}\" for i in range(1, 1001)}\nprint(f\"{len(puzzles):,} puzzles, {sum(len(p.targets) for p in puzzles.values()):,} targets\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-18T04:38:05.384099Z","iopub.execute_input":"2026-11-18T04:38:05.384431Z","iopub.status.idle":"2026-11-18T04:38:05.464745Z","shell.execute_reply.started":"2026-11-18T04:38:05.384394Z","shell.execute_reply":"2026-11-18T04:38:05.463709Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Cache short expressions\n\nFor each target, the solver keeps a dictionary of values it can reconstruct in zero, one or two instructions. Its starting points include common constants, previous targets and recent intermediate results.","metadata":{}},{"cell_type":"code","source":"%%writefile {solver_source}\n// Signed quotient/remainder search over expressions available in the current puzzle.\n#include <algorithm>\n#include <array>\n#include <cmath>\n#include <cstdint>\n#include <iostream>\n#include <map>\n#include <set>\n#include <unordered_map>\n#include <vector>\nusing namespace std;\nusing Int = int64_t;\n\nstruct Expr {\n    Int v;\n    int a = -1, b = -1;\n    char op = 0;\n    int cost = 0;\n};\nInt apply(char op, Int a, Int b) {\n    if (op == '+')\n        return a + b;\n    if (op == '-')\n        return a - b;\n    if (op == '/')\n        return a / b;\n    return a * b; // All callers check the puzzle limit before multiplying.\n}\n\n// Integer-key index reused between targets. Zero is outside the calculator domain.\nstruct Index {\n    vector<Int> keys;\n    vector<int> ids, used;\n    size_t mask;\n    Index(int bits) : keys(1u << bits), ids(keys.size()), mask(keys.size() - 1) {}\n    size_t slot(Int v) const {\n        uint64_t h = uint64_t(v) * 0x9e3779b97f4a7c15ULL;\n        h ^= h >> 31;\n        size_t i = h & mask;\n        while (keys[i] && keys[i] != v)\n            i = (i + 1) & mask;\n        return i;\n    }\n    int get(Int v) const {\n        size_t i = slot(v);\n        return keys[i] ? ids[i] : -1;\n    }\n    bool insert(Int v, int id) {\n        size_t i = slot(v);\n        if (keys[i])\n            return false;\n        used.push_back(i);\n        keys[i] = v;\n        ids[i] = id;\n        return true;\n    }\n    void clear() {\n        for (int i : used)\n            keys[i] = 0;\n        used.clear();\n    }\n};\n\nstruct Dictionary {\n    Int limit;\n    Index index{20};\n    vector<Expr> e;\n    array<vector<pair<Int, int>>, 3> sorted;\n    int n0 = 0, n1 = 0;\n    explicit Dictionary(Int limit) : limit(limit) {}\n    void add(Int v, int a, int b, char op, int cost) {\n        if (v > 0 && v <= limit && index.insert(v, e.size()))\n            e.push_back({v, a, b, op, cost});\n    }\n    void combine(int i, int j, int cost) {\n        Int a = e[i].v, b = e[j].v;\n        add(a + b, i, j, '+', cost);\n        if (a != b)\n            add(abs(a - b), a > b ? i : j, a > b ? j : i, '-', cost);\n        if (a <= limit / b)\n            add(a * b, i, j, '*', cost);\n        if (a > b && a % b == 0)\n            add(a / b, i, j, '/', cost);\n        if (b > a && b % a == 0)\n            add(b / a, j, i, '/', cost);\n    }\n    void build(const vector<Int> &leaves) {\n        index.clear();\n        e.clear();\n        for (auto &s : sorted)\n            s.clear();\n        for (Int v : leaves)\n            add(v, -1, -1, 0, 0);\n        n0 = e.size();\n        for (int i = 0; i < n0; i++)\n            for (int j = 0; j <= i; j++)\n                combine(i, j, 1);\n        n1 = e.size();\n        for (int i = n0; i < n1; i++)\n            for (int j = 0; j < n0; j++)\n                combine(i, j, 2);\n        for (int i = 0; i < int(e.size()); i++)\n            sorted[e[i].cost].emplace_back(e[i].v, i);\n        for (auto &s : sorted)\n            sort(s.begin(), s.end());\n    }\n};","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-18T04:38:05.466961Z","iopub.execute_input":"2026-11-18T04:38:05.467318Z","iopub.status.idle":"2026-11-18T04:38:05.476144Z","shell.execute_reply.started":"2026-11-18T04:38:05.46729Z","shell.execute_reply":"2026-11-18T04:38:05.475071Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Search backward from each target\n\nIf the target is close to a known multiple, the search can subtract the difference and continue from the quotient. For example, with 16 and 1 available, it can reduce 97 to 6 using the identity `97 = 6 × 16 + 1`. The beam keeps up to three candidates per round, ranked by instructions spent and the size of the remaining integer.","metadata":{}},{"cell_type":"code","source":"%%writefile -a {solver_source}\n// A reduction encodes parent = (child * factor) +/- atom, or atom - child.\nstruct Link {\n    int factor = -1, atom = -1;\n    char op = '+';\n};\nstruct State {\n    Int v;\n    int cost = 0, parent = -1;\n    Link link;\n    double rank = 0;\n};\n\nstruct Search {\n    Dictionary &d;\n    int width, best = 1000, end = -1, terminal = -1;\n    vector<State> history, next;\n    unordered_map<Int, int> visited;\n    Search(Dictionary &d, int width) : d(d), width(width) {}\n    int expr_cost(int id) const { return id < 0 ? 0 : 1 + d.e[id].cost; }\n    void offer(int p, Int v, int f, int a, char op) {\n        if (v <= 0 || v > d.limit)\n            return;\n        int cost = history[p].cost + expr_cost(f) + expr_cost(a);\n        if (cost >= best)\n            return;\n        int t = d.index.get(v);\n        if (t >= 0) {\n            if (cost + d.e[t].cost < best) {\n                best = cost + d.e[t].cost;\n                end = history.size();\n                terminal = t;\n                history.push_back({v, cost, p, {f, a, op}});\n            }\n            return;\n        }\n        if (cost + 3 >= best || v >= history[p].v)\n            return;\n        // Comparisons happen across instruction costs and residual sizes.\n        double rank = cost + 0.18 * log2(double(v));\n        if (int(next.size()) == width && rank >= next.back().rank)\n            return;\n        auto prev = visited.find(v);\n        if (prev != visited.end() && prev->second <= cost)\n            return;\n        for (auto it = next.begin(); it != next.end(); ++it)\n            if (it->v == v) {\n                if (it->cost <= cost)\n                    return;\n                next.erase(it);\n                break;\n            }\n        State s{v, cost, p, {f, a, op}, rank};\n        auto it = upper_bound(next.begin(), next.end(), rank,\n                              [](double k, const State &x) { return k < x.rank; });\n        next.insert(it, s);\n        if (int(next.size()) > width)\n            next.pop_back();\n    }\n    void expand(int p) {\n        Int v = history[p].v;\n        for (auto &arr : d.sorted) {\n            auto it = lower_bound(arr.begin(), arr.end(), make_pair(v, -1));\n            for (int k = -4; k < 4; k++) {\n                auto pos = (it - arr.begin()) + k;\n                if (pos < 0 || pos >= int(arr.size()))\n                    continue;\n                auto [a, id] = arr[pos];\n                offer(p, abs(v - a), -1, id, v > a ? '+' : 'r');\n            }\n        }\n        for (int i = 0; i < d.n1; i++) {\n            Int a = d.e[i].v;\n            if (a == 1)\n                continue;\n            Int diff = abs(v - a);\n            if (diff) {\n                if (d.index.get(diff) >= 0)\n                    offer(p, diff, -1, i, v > a ? '+' : 'r');\n                if (v > a && (diff & 15) == 0)\n                    shifted(p, diff, i, '+');\n                if (a > v && (diff & 15) == 0)\n                    shifted(p, diff, i, 'r');\n            }\n            if (a + v <= d.limit) {\n                if (d.index.get(a + v) >= 0)\n                    offer(p, a + v, -1, i, '-');\n                if (((a + v) & 15) == 0)\n                    shifted(p, a + v, i, '-');\n            }\n            if (a >= v)\n                continue;\n            Int q = v / a, r = v % a;\n            if (!r) {\n                offer(p, q, i, -1, '+');\n                continue;\n            }\n            int rid = d.index.get(r);\n            if (rid >= 0)\n                offer(p, q, i, rid, '+');\n            if (a - r <= d.limit - v) {\n                rid = d.index.get(a - r);\n                if (rid >= 0)\n                    offer(p, q + 1, i, rid, '-');\n            }\n            // Approximate the quotient by a cached expression, then synthesize the error.\n            if (i < d.n0 && q > 64) {\n                for (auto &arr : d.sorted) {\n                    auto it = lower_bound(arr.begin(), arr.end(), make_pair(q, -1));\n                    for (int k = -1; k <= 0; k++) {\n                        auto pos = (it - arr.begin()) + k;\n                        if (pos < 0 || pos >= int(arr.size()))\n                            continue;\n                        auto [b, bi] = arr[pos];\n                        if (b > d.limit / a)\n                            continue;\n                        Int mul = a * b;\n                        if (mul == v)\n                            continue;\n                        int id = d.index.get(mul);\n                        if (id >= 0)\n                            offer(p, abs(mul - v), -1, id, mul < v ? '+' : 'r');\n                    }\n                }\n            }\n        }\n    }\n    void shifted(int p, Int diff, int atom, char op) {\n        int k = __builtin_ctzll(diff);\n        while (k >= 4) {\n            int f = d.index.get(Int(1) << k);\n            if (f >= 0) {\n                offer(p, diff >> k, f, atom, op);\n                break;\n            }\n            k--;\n        }\n    }\n    void run(Int target) {\n        history.push_back({target, 0, -1, {}});\n        int id = d.index.get(target);\n        if (id >= 0) {\n            end = 0;\n            terminal = id;\n            best = d.e[id].cost;\n            return;\n        }\n        vector<int> front{0};\n        for (int depth = 0; depth < 20 && !front.empty(); depth++) {\n            next.clear();\n            for (int p : front)\n                if (history[p].cost + 3 < best)\n                    expand(p);\n            front.clear();\n            for (State s : next) {\n                if (s.cost + 3 >= best)\n                    continue;\n                visited[s.v] = s.cost;\n                front.push_back(history.size());\n                history.push_back(s);\n            }\n        }\n    }\n};","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-18T04:38:05.477252Z","iopub.execute_input":"2026-11-18T04:38:05.477533Z","iopub.status.idle":"2026-11-18T04:38:05.509096Z","shell.execute_reply.started":"2026-11-18T04:38:05.47751Z","shell.execute_reply":"2026-11-18T04:38:05.508092Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Assign the 48 registers\n\nThe solver traces the dependencies of each target and emits the arithmetic they require. When the register bank fills up, it favors overwriting a value whose next use is farthest away. It can rebuild that value if a later instruction needs it.","metadata":{}},{"cell_type":"code","source":"%%writefile -a {solver_source}\nstruct Puzzle {\n    Int limit;\n    vector<Int> starts, targets, palette;\n    map<Int, Expr> defs;\n    vector<Int> order;\n    int width;\n    Puzzle(Int limit, int width) : limit(limit), width(width) {}\n    Int make(char op, Int a, Int b) {\n        Int v = apply(op, a, b);\n        if (v <= 0 || v > limit)\n            throw runtime_error(\"invalid construction\");\n        if (!defs.count(v)) {\n            defs[v] = {v, -1, -1, op};\n            args[v] = {a, b};\n            order.push_back(v);\n        }\n        return v;\n    }\n    map<Int, pair<Int, Int>> args;\n    Int power(int k) {\n        Int v = Int(1) << k;\n        if (defs.count(v))\n            return v;\n        if (k == 1)\n            return make('+', 1, 1);\n        Int right = power(k - k / 2);\n        Int left = power(k / 2);\n        return make('*', left, right);\n    }\n    void setup() {\n        for (Int v : starts)\n            defs[v] = {v};\n        if (!defs.count(1))\n            make('/', starts[0], starts[0]);\n        palette = {1};\n        for (int k : {1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 16, 20, 24, 32, 40, 48}) {\n            if ((Int(1) << k) <= limit)\n                palette.push_back(power(k));\n        }\n        for (int i : {3, 5, 7, 9, 11, 13, 15, 17, 19, 23, 31})\n            if (i <= limit) {\n                if (!defs.count(i)) {\n                    if (i == 11 || i == 13 || i == 19 || i == 23)\n                        make('+', i - (i == 23 ? 16 : 8), i == 23 ? 16 : 8);\n                    else if ((i & (i + 1)) == 0 && i + 1 <= limit)\n                        make('-', i + 1, 1);\n                    else\n                        binary(i);\n                }\n                palette.push_back(i);\n            }\n    }\n    Int materialize(Dictionary &d, int id) {\n        const Expr &e = d.e[id];\n        if (defs.count(e.v))\n            return e.v;\n        Int right = materialize(d, e.b);\n        Int left = materialize(d, e.a);\n        return make(e.op, left, right);\n    }\n    Int binary(Int v) {\n        if (defs.count(v))\n            return v;\n        Int h = binary(v / 2);\n        Int twice = make('+', h, h);\n        return v % 2 ? make('+', twice, 1) : twice;\n    }\n    void solve() {\n        setup();\n        Dictionary d(limit);\n        set<Int> done;\n        for (Int target : targets) {\n            if (!defs.count(target)) {\n                vector<Int> leaves;\n                set<Int> used;\n                auto add = [&](Int v) {\n                    if (used.insert(v).second)\n                        leaves.push_back(v);\n                };\n                for (Int v : palette)\n                    add(v);\n                for (Int v : starts)\n                    add(v);\n                for (auto it = done.rbegin(); it != done.rend() && leaves.size() < 52; ++it)\n                    add(*it);\n                for (auto it = order.rbegin(); it != order.rend() && leaves.size() < 56; ++it)\n                    add(*it);\n                d.build(leaves);\n                Search s(d, width);\n                s.run(target);\n                if (s.end < 0)\n                    binary(target);\n                else {\n                    Int v = materialize(d, s.terminal);\n                    for (int p = s.end; s.history[p].parent >= 0; p = s.history[p].parent) {\n                        Link l = s.history[p].link;\n                        if (l.factor >= 0)\n                            v = make('*', v, materialize(d, l.factor));\n                        if (l.atom >= 0) {\n                            Int a = materialize(d, l.atom);\n                            v = l.op == 'r' ? make('-', a, v) : make(l.op, v, a);\n                        }\n                    }\n                    if (v != target)\n                        throw runtime_error(\"search reconstruction failed\");\n                }\n            }\n            done.insert(target);\n        }\n    }\n    // Walk dependencies on demand, then allocate registers by their next use.\n    // An evicted value can always be rebuilt from its expression or a protected seed.\n    vector<array<int, 4>> compile() {\n        set<Int> placed(starts.begin(), starts.end());\n        vector<Int> sequence;\n        auto visit = [&](auto &&self, Int v) -> void {\n            if (!placed.insert(v).second)\n                return;\n            auto [a, b] = args.at(v);\n            self(self, a);\n            self(self, b);\n            sequence.push_back(v);\n        };\n        for (Int t : targets)\n            visit(visit, t);\n        map<Int, vector<int>> uses;\n        for (int i = int(sequence.size()) - 1; i >= 0; --i) {\n            auto [a, b] = args.at(sequence[i]);\n            uses[a].push_back(i);\n            if (a != b)\n                uses[b].push_back(i);\n        }\n        array<Int, 48> bank{};\n        set<Int> seeds(starts.begin(), starts.end());\n        copy(starts.begin(), starts.end(), bank.begin());\n        vector<array<int, 4>> program;\n        auto emit = [&](auto &&self, Int v, uint64_t locked) -> int {\n            auto found = find(bank.begin(), bank.end(), v);\n            if (found != bank.end())\n                return found - bank.begin();\n            auto [a, b] = args.at(v);\n            int ra = self(self, a, locked), rb = self(self, b, locked | (1ULL << ra));\n            int rd = -1, latest = -1;\n            for (int k = 0; k < 48; k++) {\n                Int old = bank[k];\n                if ((locked >> k & 1) || seeds.count(old))\n                    continue;\n                int nextuse = uses[old].empty() ? 1000000 : uses[old].back();\n                if (!old) {\n                    rd = k;\n                    break;\n                }\n                if (nextuse > latest) {\n                    rd = k;\n                    latest = nextuse;\n                }\n            }\n            if (rd < 0)\n                throw runtime_error(\"register allocation failed\");\n            bank[rd] = v;\n            program.push_back({defs.at(v).op, ra, rb, rd});\n            return rd;\n        };\n        for (Int v : sequen